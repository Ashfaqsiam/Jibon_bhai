<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050814">

    <!-- Authentication Pages -->
    <include android:id="@+id/scannerPage" layout="@layout/layout_scanner" />
    <include android:id="@+id/loginPage" layout="@layout/layout_login" />
    <include android:id="@+id/registerPage" layout="@layout/layout_register" />

    <!-- Logged In Container (ViewPager + Bottom Nav) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loggedInContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Swipeable ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/sharedBottomNav" />

        <!-- Shared Bottom Navigation (Stays Fixed) -->
        <LinearLayout
            android:id="@+id/sharedBottomNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:weightSum="5"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/navInbox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Inbox"
                android:textColor="#3975C6"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navGroups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Groups"
                android:textColor="#8F9BB3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navDash"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Dash"
                android:textColor="#8F9BB3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profile"
                android:textColor="#8F9BB3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/navLogout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Logout"
                android:textColor="#E53935"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>