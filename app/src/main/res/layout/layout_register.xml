<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:visibility="gone"
    tools:visibility="visible"
    tools:background="#050814">

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogoReg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_launcher_foreground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#00FF33" />

    <!-- Headers -->
    <TextView
        android:id="@+id/tvTitleReg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIGEON"
        android:textColor="#00FF33"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/ivLogoReg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvSubtitleReg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NODE REGISTRATION PROTOCOL"
        android:textColor="#4A84E8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/tvTitleReg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Registration Form Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/regContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_auth_container"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleReg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/tvRegHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="> CONFIGURE NEW NODE"
            android:textColor="#4A84E8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="monospace"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Full Name Input -->
        <TextView
            android:id="@+id/tvFullNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER_FULL_NAME :"
            android:textColor="#00FF33"
            android:textSize="12sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/tvRegHeader"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_input_field"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:textColorHint="#4A5A7A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvFullNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Phone Number Input -->
        <TextView
            android:id="@+id/tvPhoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER_MOBILE_PHONE_NUMBER :"
            android:textColor="#00FF33"
            android:textSize="12sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/etFullName"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_input_field"
            android:hint="Phone Number"
            android:inputType="phone"
            android:textColorHint="#4A5A7A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Email Address Input -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER_EMAIL_ADDRESS :"
            android:textColor="#00FF33"
            android:textSize="12sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/etPhone"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_input_field"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:textColorHint="#4A5A7A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvEmailLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

        <!-- Password Input -->
        <TextView
            android:id="@+id/tvPassLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER_PASSWORD :"
            android:textColor="#00FF33"
            android:textSize="12sp"
            android:fontFamily="monospace"
            app:layout_constraintTop_toBottomOf="@id/etEmail"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etPassReg"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/bg_input_field"
            android:hint="Create Password"
            android:inputType="textPassword"
            android:textColorHint="#4A5A7A"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvPassLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Action Buttons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnInitReg"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="INITIALIZE REGISTRATION"
        android:textColor="#00FF33"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_btn_primary_outline"
        app:layout_constraintTop_toBottomOf="@id/regContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnReturnLogin"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="EXIT/RETURN TO LOGIN"
        android:textColor="#4A84E8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_btn_secondary_outline"
        app:layout_constraintTop_toBottomOf="@id/btnInitReg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>