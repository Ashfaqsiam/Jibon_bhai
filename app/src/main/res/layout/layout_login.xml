<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone"
    tools:visibility="visible"
    android:background="#050814">

    <!-- Inner ConstraintLayout expands with the ScrollView -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Logo and Header -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#00FF33" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIGEON"
            android:textColor="#00FF33"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURE ACCESS PORTAL"
            android:textColor="#4A84E8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- Authentication Form Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/authContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_container"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvAuthHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="> AUTHENTICATION REQUIRED"
                android:textColor="#4A84E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:fontFamily="monospace"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- User ID Input -->
            <TextView
                android:id="@+id/tvUserIdLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER_ID :"
                android:textColor="#00FF33"
                android:textSize="12sp"
                android:fontFamily="monospace"
                app:layout_constraintTop_toBottomOf="@id/tvAuthHeader"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etUserId"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter User ID/Phone/Email"
                android:textColorHint="#4A5A7A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUserIdLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Password Input -->
            <TextView
                android:id="@+id/tvUserPassLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER_PASS :"
                android:textColor="#00FF33"
                android:textSize="12sp"
                android:fontFamily="monospace"
                app:layout_constraintTop_toBottomOf="@id/etUserId"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etUserPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:hint="Enter Password"
                android:inputType="textPassword"
                android:textColorHint="#4A5A7A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUserPassLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Action Buttons -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnInitiateLogin"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="INITIATE LOGIN"
            android:textColor="#00FF33"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_primary_outline"
            app:layout_constraintTop_toBottomOf="@id/authContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGenerateId"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:text="GENERATE NEW USER ID"
            android:textColor="#4A84E8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_btn_secondary_outline"
            app:layout_constraintTop_toBottomOf="@id/btnInitiateLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

        <!-- Bottom Footer (Universal Placement) -->
        <TextView
            android:id="@+id/tvAbort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:letterSpacing="0.05"
            android:text="ABORT / RETURN TO SCANNER"
            android:textColor="#4A5A7A"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnGenerateId"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>